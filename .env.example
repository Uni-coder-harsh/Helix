# Helix Configuration - Environment Variables Example
# Copy this file to .env for local development

# General Configuration
APP_NAME=helix-backend
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Application HTTP Settings
HOST=0.0.0.0
PORT=8000

# Backend Relational Database Configuration
# Default sqlite for local mock runs
DATABASE_URL=sqlite:///./helix.db
# Production PostgreSQL example
# POSTGRES_URL=postgresql://helix_user:secure_password@postgres:5432/helix_db

# NoSQL & Caching Services
# MONGODB_URI=mongodb://root:secure_password@mongodb:27017/helix?authSource=admin
# REDIS_URL=redis://redis:6379/0

# ==============================
# AI & OpenRouter Configuration
# ==============================
# Options: 'openrouter', 'gemma', 'gemini', or 'mock'
LLM_PROVIDER=openrouter
# Models: 'google/gemma-2-27b-it', 'google/gemma-2-9b-it', 'gemma-2-27b-it', 'gemma-2-9b-it'
LLM_MODEL=google/gemma-2-27b-it
OPENROUTER_API_KEY=
GEMMA_API_KEY=
GEMINI_API_KEY=
# OpenRouter API URL endpoint
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Spatial Geo-Intelligence Platform Config
MAP_PROVIDER=osm
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
PLACES_PROVIDER=overpass
PLACES_BASE_URL=https://overpass-api.de/api/interpreter

# Object Storage Configuration
# MINIO_ENDPOINT=http://minio:9000
# S3_BUCKET=helix-assets

# Identity & OAuth Configurations
# JWT_SECRET_KEY=generate-a-secure-32-byte-hex-key-for-jwt-signing
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GITHUB_CLIENT_ID=your-github-oauth-client-id

# Notification & SMS Configurations
NOTIFICATION_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
DEFAULT_CITIZEN_PHONE=+15550192834

# Email Notification Configurations (HTTP API or SMTP)
EMAIL_PROVIDER=http
EMAIL_API_URL=https://api.sendgrid.com/v3/mail/send
EMAIL_API_KEY=your_sendgrid_or_email_api_key
EMAIL_FROM=noreply@helix.dev

# SMTP Fallback Configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Project Helix <noreply@helix.dev>

# Cloud Provider Settings
# GCP_PROJECT=helix-platform-prod
